# Copy this file to .env and fill in your own keys.

# Required: lets the crew's agents think (CrewAI routes this through LiteLLM).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Where ANTHROPIC_API_KEY is reserved (e.g. Claude Code cloud environments),
# set CREW_ANTHROPIC_API_KEY instead -- crew.py copies it across.

# Optional: only needed if you wire up ClientResearchTool to a real search API.
# Without it, ClientResearchTool returns a note saying no live search is configured
# instead of fabricating results.
SERPER_API_KEY=

# n8n (docker-compose.yml). Public base URL if you expose n8n for webhooks.
GENERIC_TIMEZONE=America/New_York
N8N_WEBHOOK_URL=http://localhost:5678/
