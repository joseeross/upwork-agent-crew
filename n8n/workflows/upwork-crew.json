{
  "name": "Upwork Agent Crew",
  "nodes": [
    {
      "id": "a1",
      "name": "Paste Job Posting",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "6b1f2c0e-5a3d-4c1e-9f0a-0000000000a1",
      "parameters": {
        "formTitle": "Upwork Job Triage",
        "formDescription": "Paste a full Upwork posting. The crew scores it and drops a Gmail draft with the result.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job posting",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Force proposal",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "No"
                  },
                  {
                    "option": "Yes"
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a2",
      "name": "Job Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "6b1f2c0e-5a3d-4c1e-9f0a-0000000000a2",
      "parameters": {
        "httpMethod": "POST",
        "path": "upwork-job",
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "posting",
              "type": "string",
              "value": "={{ $json['Job posting'] ?? $json.body?.posting ?? '' }}"
            },
            {
              "id": "s2",
              "name": "force",
              "type": "boolean",
              "value": "={{ $json['Force proposal'] === 'Yes' || $json.body?.force === true }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4",
      "name": "Run Crew",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://crew-api:8000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ posting: $json.posting, force: $json.force }) }}",
        "options": {
          "timeout": 900000
        }
      }
    },
    {
      "id": "a5",
      "name": "Proposal Drafted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.proposal }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a6",
      "name": "Gmail Draft: Proposal",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "resource": "draft",
        "subject": "={{ '[' + $json.verdict + ($json.forced ? ' / FORCED' : '') + '] ' + $('Normalize Input').item.json.posting.trim().split('\\n')[0].slice(0, 80) }}",
        "emailType": "text",
        "message": "=PROPOSAL\n========\n{{ $json.proposal }}\n\n\nFIT ANALYSIS\n============\n{{ $json.fit_output }}\n\n\nCLIENT RESEARCH\n===============\n{{ $json.research_output }}",
        "options": {}
      }
    },
    {
      "id": "a7",
      "name": "Gmail Draft: Skip Note",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        200
      ],
      "parameters": {
        "resource": "draft",
        "subject": "={{ '[SKIP] ' + $('Normalize Input').item.json.posting.trim().split('\\n')[0].slice(0, 80) }}",
        "emailType": "text",
        "message": "=Fit Analyst said SKIP. Re-submit with Force proposal = Yes to draft one anyway.\n\nFIT ANALYSIS\n============\n{{ $json.fit_output }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Paste Job Posting": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Run Crew",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Crew": {
      "main": [
        [
          {
            "node": "Proposal Drafted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Proposal Drafted?": {
      "main": [
        [
          {
            "node": "Gmail Draft: Proposal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gmail Draft: Skip Note",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}